        "#Q1. Write a program that accepts a student's full name (e.g., \"Priya Sharma\") and birth year (e.g., 2006), and generates a username made of the first three letters of the first name in lower case, the first letter of the surname in upper case and the last two digits of the birth year (e.g., priS06). Print the username and the email id username@university.edu.  [10 Marks]\n",
        "#accept students full name and birth year\n",
        "full_name = input(\"Enter student's full name: \")\n",
        "birth_year = input(\"Enter student's birth year: \")\n",
        "\n",
        "#split the full name and surname\n",
        "names = full_name.split()\n",
        "first_name = names[0]\n",
        "surname = names[-1] if len(names) > 1 else \"\"\n",
        "\n",
        "#generate username components\n",
        "part1 = first_name[:3].lower() #first three letters of first name in lower case\n",
        "part2 = surname[0].upper() if surname else \"\" #first letter of surname in upper case\n",
        "part3 = birth_year[-2:] #last two digits of the birth year\n",
        "\n",
        "#combine to form username\n",
        "username = f\"{part1}{part2}{part3}\"\n",
        "email_id = f\"{username}@university.edu\"\n",
        "\n",
        "#print results\n",
        "print(f\"Username: {username}\")\n",
        "print(f\"Email ID: {email_id}\")"
      ],
