        "#Q2. Write a function to_binary(n) that converts a positive decimal integer to a binary string using a while loop with // and % (without bin() or format()), and a function to_decimal(b) that converts a binary string back to decimal using a for loop. Test both for 10, 37 and 255 and verify each result by comparing with bin().\n",
        "def to_binary(n):\n",
        "    if n == 0:\n",
        "        return \"0\"\n",
        "    binary_str = \"\"\n",
        "    while n > 0:\n",
        "        binary_str = str(n % 2) + binary_str\n",
        "        n = n // 2\n",
        "        return binary_str\n",
        "\n",
        "def to_decimal(b):\n",
        "    decimal_val = 0\n",
        "    for char in b:\n",
        "        decimal_val = decimal_val * 2 + int(char)\n",
        "    return decimal_val\n",
        "  #test numbers\n",
        "test_numbers = [10, 37, 255]\n",
        "\n",
        "for num in test_numbers:\n",
        "    binary_res = to_binary(num)\n",
        "    decimal_res = to_decimal(binary_res)\n",
        "    bin_builtin = bin(num)[2:]  # Strip the '0b' prefix\n",
        "    print(f\"Decimal: {num}\")\n",
        "\n",
        "\n",
        "\n",
        "    print(f\"  Generated Binary: {binary_res}\")\n",
        "    print(f\"  Built-in bin():   {bin_builtin} (Match: {binary_res == bin_builtin})\")\n",
        "    print(f\"  Back to Decimal:  {decimal_res} (Match: {decimal_res == num})\")\n",
        "    print(\"-\" * 40)"
